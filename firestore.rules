rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
      // Private to owner / admin (Sreerag Dermal) and the user themselves
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email in ['sreeragdermal@gmail.com', 'Sreeragdermal@gmail.com']
      );

      // Private cross-device real-time financial ledger
      match /ledger/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Unified 1-Email = 1-Account store: accessible across Computer and Mobile Web
    match /accounts/{accountKey} {
      allow read, write: if true;
      match /ledger/{document} {
        allow read, write: if true;
      }
    }

    match /test/{document} {
      allow read: if true;
    }
  }
}
